                        }
                    ]
                }
            },
            "title": "?.route?.name"
        },
        {
            "pattern": "/products/:id",
            "config": {
                "map": {
                    "categories": [
                        "nav",
                        {
                            "class :=": "categories",
                            "aria-label :=": "Categories"
                        },
                        {
                            "each": [
                                "a",
                                {
                                    "href :=": {
                                        "join": [
                                            "products/category/",
                                            "?."
                                        ]
                                    },
                                    "textContent": "?."
                                }
                            ],
                            "of": "?."
                        }
                    ],
                    "data": [
                        {
                            "tag": "article",
                            "ish": "product-view"
                        },
                        {
                            "class :=": "detail"
                        },
                        [
                            [
                                "img",
                                {
                                    "src :=": "?.image",
                                    "alt :=": "?.title",
                                    "style :=": {
                                        "join": [
                                            "view-transition-name: product-",
                                            "?.id"
                                        ]
                                    }
                                }
                            ],
                            [
                                "div",
                                {
                                    "class :=": "info"
                                },
                                [
                                    [
                                        "h2",
                                        {
                                            "textContent": "?.title"
                                        }
                                    ],
                                    [
                                        "p",
                                        {
                                            "class :=": "category",
                                            "textContent": "?.category"
                                        }
                                    ],
                                    [
                                        "p",
                                        {
                                            "class :=": "price",
                                            "textContent": "?.price?.usd"
                                        }
                                    ],
                                    [
                                        "p",
                                        {
                                            "class :=": "rating"
                                        },
                                        [
                                            [
                                                "meter",
                                                {
                                                    "class :=": "stars",
                                                    "min :=": "0",
                                                    "max :=": "5",
                                                    "value :=": "?.rating?.rate"
                                                }
                                            ],
                                            [
                                                "span",
                                                {
                                                    "?. =&": {
                                                        "microJoin": [
                                                            "?.rating?.rate",
                                                            " (",
                                                            "?.rating?.count",
                                                            ")"
                                                        ]
                                                    }
                                                }
                                            ]
                                        ]
                                    ],
                                    [
                                        "div",
                                        {
                                            "class :=": "buy"
                                        },
                                        [
                                            [
                                                "div",
                                                {
                                                    "class :=": "stepper",
                                                    "role :=": "group",
                                                    "aria-label :=": "Quantity"
                                                },
                                                [
                                                    [
                                                        "button",
                                                        {
                                                            "type :=": "button",
                                                            "aria-label :=": "One less",
                                                            " +=": {
                                                                "on": "click",
                                                                "call": "less"
                                                            },
                                                            "textContent": "−"
                                                        }
                                                    ],
                                                    [
                                                        "output",
                                                        {
                                                            "textContent": "?.quantity"
                                                        }
                                                    ],
                                                    [
                                                        "button",
                                                        {
                                                            "type :=": "button",
                                                            "aria-label :=": "One more",
                                                            " +=": {
                                                                "on": "click",
                                                                "call": "more"
                                                            },
                                                            "textContent": "+"
                                                        }
                                                    ]
                                                ]
                                            ],
                                            [
                                                "button",
                                                {
                                                    "type :=": "button",
                                                    "class :=": "add",
                                                    " +=": {
                                                        "on": "click",
                                                        "call": "add"
                                                    },
                                                    "?. =&": {
                                                        "microJoin": [
                                                            "Add ",
                                                            "?.lineTotal?.usd",
                                                            " to cart"
                                                        ]
                                                    }
                                                }
                                            ]
                                        ]
                                    ],
                                    [
                                        "p",
                                        {
                                            "class :=": "description",
                                            "textContent": "?.description"
                                        }
                                    ]
                                ]
                            ]
                        ]
                    ]
                }
            },
            "title": "?.data?.title"
        }
    ],
    "options": {
        "pipes": {
            "usd": {
                "intl": "NumberFormat",
                "locale": "en-US",
                "options": {
                    "style": "currency",
                    "currency": "USD"
                }
            },
            "itemCount": {
                "sum": "?.quantity"
            },
            "subtotal": {
                "sum": [
                    "?.quantity",
                    "?.price"
                ]
            },
            "total": {
                "chain": [
                    "subtotal",
                    "usd"
                ]
            }
        },
        "managers": {
            "product-view": {
                "import": "./productView.js",
                "export": "ProductView"
            }
        },
        "style": true
    }
}