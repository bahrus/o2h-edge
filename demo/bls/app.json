{
    "api": "https://api.bls.gov/publicAPI/v2",
    "routes": [
        {
            "pattern": "/",
            "sources": {
                "data": "timeseries/popular"
            },
            "config": {
                "map": {
                    "?.data?.message": [
                        "ul",
                        {
                            "class :=": "messages"
                        },
                        {
                            "each": [
                                "li",
                                {
                                    "textContent": "?."
                                }
                            ],
                            "of": "?."
                        }
                    ],
                    "?.data?.Results?.series": [
                        "ul",
                        {
                            "class :=": "series-list"
                        },
                        {
                            "each": [
                                "li",
                                {},
                                [
                                    [
                                        "a",
                                        {
                                            "href :=": {
                                                "join": [
                                                    "timeseries/data/",
                                                    "?.seriesID"
                                                ]
                                            }
                                        },
                                        [
                                            [
                                                "span",
                                                {
                                                    "class :=": "id",
                                                    "textContent": "?.seriesID"
                                                }
                                            ],
                                            [
                                                "span",
                                                {
                                                    "class :=": "name",
                                                    "textContent": "?.seriesID?.seriesName"
                                                }
                                            ]
                                        ]
                                    ]
                                ]
                            ],
                            "of": "?.",
                            "empty": [
                                "li",
                                {
                                    "class :=": "empty",
                                    "textContent": "No series."
                                }
                            ]
                        }
                    ]
                }
            },
            "title": "BLS data"
        },
        {
            "pattern": "/surveys",
            "config": {
                "map": {
                    "?.data?.message": [
                        "ul",
                        {
                            "class :=": "messages"
                        },
                        {
                            "each": [
                                "li",
                                {
                                    "textContent": "?."
                                }
                            ],
                            "of": "?."
                        }
                    ],
                    "?.data?.Results?.survey": [
                        "ul",
                        {
                            "class :=": "surveys"
                        },
                        {
                            "each": [
                                "li",
                                {},
                                [
                                    [
                                        "a",
                                        {
                                            "href :=": {
                                                "join": [
                                                    "surveys/",
                                                    "?.survey_abbreviation"
                                                ]
                                            }
                                        },
                                        [
                                            [
                                                "span",
                                                {
                                                    "class :=": "abbr",
                                                    "textContent": "?.survey_abbreviation"
                                                }
                                            ],
                                            [
                                                "span",
                                                {
                                                    "textContent": "?.survey_name"
                                                }
                                            ]
                                        ]
                                    ]
                                ]
                            ],
                            "of": "?.",
                            "key": "?.survey_abbreviation"
                        }
                    ]
                }
            },
            "title": "Surveys"
        },
        {
            "pattern": "/surveys/:abbr",
            "sources": {
                "survey": "surveys/{abbr}",
                "popular": "timeseries/popular?survey={abbr}"
            },
            "config": {
                "map": {
                    "?.survey?.message": [
                        "ul",
                        {
                            "class :=": "messages"
                        },
                        {
                            "each": [
                                "li",
                                {
                                    "textContent": "?."
                                }
                            ],
                            "of": "?."
                        }
                    ],
                    "?.survey?.Results?.survey?.0": [
                        "header",
                        {
                            "class :=": "survey"
                        },
                        [
                            [
                                "h2",
                                {},
                                [
                                    [
                                        "span",
                                        {
                                            "textContent": "?.survey_name"
                                        }
                                    ],
                                    [
                                        "span",
                                        {
                                            "class :=": "abbr",
                                            "textContent": "?.survey_abbreviation"
                                        }
                                    ]
                                ]
                            ],
                            [
                                "ul",
                                {
                                    "class :=": "flags"
                                },
                                [
                                    {
                                        "switch": "?.allowsNetChange",
                                        "cases": {
                                            "true": [
                                                "li",
                                                {
                                                    "textContent": "Net changes"
                                                }
                                            ]
                                        },
                                        "default": null
                                    },
                                    {
                                        "switch": "?.allowsPercentChange",
                                        "cases": {
                                            "true": [
                                                "li",
                                                {
                                                    "textContent": "Percent changes"
                                                }
                                            ]
                                        },
                                        "default": null
                                    },
                                    {
                                        "switch": "?.hasAnnualAverages",
                                        "cases": {
                                            "true": [
                                                "li",
                                                {
                                                    "textContent": "Annual averages"
                                                }
                                            ]
                                        },
                                        "default": null
                                    }
                                ]
                            ]
                        ]
                    ],
                    "?.popular?.message": [
                        "ul",
                        {
                            "class :=": "messages"
                        },
                        {
                            "each": [
                                "li",
                                {
                                    "textContent": "?."
                                }
                            ],
                            "of": "?."
                        }
                    ],
                    "?.popular?.Results?.series": [
                        "ul",
                        {
                            "class :=": "series-list"
                        },
                        {
                            "each": [
                                "li",
                                {},
                                [
                                    [
                                        "a",
                                        {
                                            "href :=": {
                                                "join": [
                                                    "timeseries/data/",
                                                    "?.seriesID"
                                                ]
                                            }
                                        },
                                        [
                                            [
                                                "span",
                                                {
                                                    "class :=": "id",
                                                    "textContent": "?.seriesID"
                                                }
                                            ],
                                            [
                                                "span",
                                                {
                                                    "class :=": "name",
                                                    "textContent": "?.seriesID?.seriesName"
                                                }
                                            ]
                                        ]
                                    ]
                                ]
                            ],
                            "of": "?.",
                            "empty": [
                                "li",
                                {
                                    "class :=": "empty",
                                    "textContent": "No series."
                                }
                            ]
                        }
                    ]
                }
            },
            "title": "?.survey?.Results?.survey?.0?.survey_name"
        },
        {
            "pattern": "/timeseries/data/:id",
            "config": {
                "map": {
                    "?.data?.message": [
                        "ul",
                        {
                            "class :=": "messages"
                        },
                        {
                            "each": [
                                "li",
                                {
                                    "textContent": "?."
                                }
                            ],
                            "of": "?."
                        }
                    ],
                    "?.data?.Results?.series?.0": [
                        "section",
                        {
                            "class :=": "series"
                        },
                        [
                            [
                                "h2",
                                {
                                    "textContent": "?.seriesID"
                                }
                            ],
                            [
                                "p",
                                {
                                    "class :=": "name",
                                    "textContent": "?.seriesID?.seriesName"
                                }
                            ],
                            {
                                "switch": "?.data?.0?.latest",
                                "cases": {
                                    "true": [
                                        "p",
                                        {
                                            "class :=": "latest"
                                        },
                                        [
                                            [
                                                "span",
                                                {
                                                    "class :=": "value",
                                                    "textContent": "?.data?.0?.value"
                                                }
                                            ],
                                            [
                                                "span",
                                                {
                                                    "?. =&": {
                                                        "microJoin": [
                                                            "?.data?.0?.periodName",
                                                            " ",
                                                            "?.data?.0?.year",
                                                            ", the latest"
                                                        ]
                                                    }
                                                }
                                            ]
                                        ]
                                    ]
                                },
                                "default": null
                            },
                            [
                                "figure",
                                {
                                    "class :=": "chart",
                                    "style :=": {
                                        "join": [
                                            "--low: ",
                                            "?.data?.low",
                                            "; --high: ",
                                            "?.data?.high"
                                        ]
                                    }
                                },
                                [
                                    [
                                        "ol",
                                        {
                                            "class :=": "bars",
                                            "aria-hidden :=": "true"
                                        },
                                        {
                                            "each": [
                                                "li",
                                                {
                                                    "style :=": {
                                                        "join": [
                                                            "--v: ",
                                                            "?.value"
                                                        ]
                                                    },
                                                    "data-period :=": "?.period",
                                                    "title :=": {
                                                        "join": [
                                                            "?.periodName",
                                                            " ",
                                                            "?.year",
                                                            ": ",
                                                            "?.value"
                                                        ]
                                                    }
                                                }
                                            ],
                                            "of": "?.data"
                                        }
                                    ],
                                    [
                                        "figcaption",
                                        {},
                                        [
                                            [
                                                "span",
                                                {
                                                    "?. =&": {
                                                        "microJoin": [
                                                            "Lowest ",
                                                            "?.data?.low"
                                                        ]
                                                    }
                                                }
                                            ],
                                            [
                                                "span",
                                                {
                                                    "?. =&": {
                                                        "microJoin": [
                                                            "highest ",
                                                            "?.data?.high"
                                                        ]
                                                    }
                                                }
                                            ]
                                        ]
                                    ]
                                ]
                            ],
                            [
                                "table",
                                {},
                                [
                                    [
                                        "thead",
                                        {},
                                        [
                                            [
                                                "tr",
                                                {},
                                                [
                                                    [
                                                        "th",
                                                        {
                                                            "scope :=": "col",
                                                            "textContent": "Year"
                                                        }
                                                    ],
                                                    [
                                                        "th",
                                                        {
                                                            "scope :=": "col",
                                                            "textContent": "Period"
                                                        }
                                                    ],
                                                    [
                                                        "th",
                                                        {
                                                            "scope :=": "col",
                                                            "class :=": "value",
                                                            "textContent": "Value"
                                                        }
                                                    ],
                                                    [
                                                        "th",
                                                        {
                                                            "scope :=": "col",
                                                            "textContent": "Notes"
                                                        }
                                                    ]
                                                ]
                                            ]
                                        ]
                                    ],
                                    [
                                        "tbody",
                                        {},
                                        {
                                            "each": [
                                                "tr",
                                                {
                                                    "data-period :=": "?.period"
                                                },
                                                [
                                                    [
                                                        "td",
                                                        {
                                                            "textContent": "?.year"
                                                        }
                                                    ],
                                                    [
                                                        "td",
                                                        {
                                                            "textContent": "?.periodName"
                                                        }
                                                    ],
                                                    [
                                                        "td",
                                                        {
                                                            "class :=": "value",
                                                            "textContent": "?.value"
                                                        }
                                                    ],
                                                    [
                                                        "td",
                                                        {
                                                            "class :=": "notes"
                                                        },
                                                        {
                                                            "each": [
                                                                "span",
                                                                {
                                                                    "textContent": "?.text"
                                                                }
                                                            ],
                                                            "of": "?.footnotes"
                                                        }
                                                    ]
                                                ]
                                            ],
                                            "of": "?.data",
                                            "empty": [
                                                "tr",
                                                {},
                                                [
                                                    [
                                                        "td",
                                                        {
                                                            "colspan :=": "4",
                                                            "class :=": "empty",
                                                            "textContent": "No data."
                                                        }
                                                    ]
                                                ]
                                            ]
                                        }
                                    ]
                                ]
                            ]
                        ]
                    ]
                }
            },
            "title": "?.route?.id"
        }
    ],
    "options": {
        "pipes": {
            "low": {
                "min": "?.value"
            },
            "high": {
                "max": "?.value"
            },
            "seriesName": {
                "map": {
                    "CUUR0000SA0": "CPI-U, all items, not seasonally adjusted",
                    "CUSR0000SA0": "CPI-U, all items, seasonally adjusted",
                    "CUUR0000SA0L1E": "CPI-U, all items less food and energy, not seasonally adjusted",
                    "CUSR0000SA0L1E": "CPI-U, all items less food and energy, seasonally adjusted",
                    "CUUR0000SA0E": "CPI-U, energy, not seasonally adjusted",
                    "CUSR0000SA0E": "CPI-U, energy, seasonally adjusted",
                    "CUUR0000SAF1": "CPI-U, food, not seasonally adjusted",
                    "CUSR0000SAF1": "CPI-U, food, seasonally adjusted",
                    "CUUR0000SAF11": "CPI-U, food at home, not seasonally adjusted",
                    "CUSR0000SAF11": "CPI-U, food at home, seasonally adjusted",
                    "CUUR0000SAH1": "CPI-U, shelter, not seasonally adjusted",
                    "CUSR0000SAH1": "CPI-U, shelter, seasonally adjusted",
                    "CUUR0000SEHA": "CPI-U, rent of primary residence, not seasonally adjusted",
                    "CUSR0000SEHA": "CPI-U, rent of primary residence, seasonally adjusted",
                    "CUUR0000SEHC": "CPI-U, owners' equivalent rent of residences, not seasonally adjusted",
                    "CUSR0000SEHC": "CPI-U, owners' equivalent rent of residences, seasonally adjusted",
                    "CUUR0000SAA": "CPI-U, apparel, not seasonally adjusted",
                    "CUSR0000SAA": "CPI-U, apparel, seasonally adjusted",
                    "CUUR0000SAM": "CPI-U, medical care, not seasonally adjusted",
                    "CUSR0000SAM": "CPI-U, medical care, seasonally adjusted",
                    "CUUR0000SAR": "CPI-U, recreation, not seasonally adjusted",
                    "CUSR0000SAR": "CPI-U, recreation, seasonally adjusted",
                    "CUUR0000SETA01": "CPI-U, new vehicles, not seasonally adjusted",
                    "CUSR0000SETA01": "CPI-U, new vehicles, seasonally adjusted",
                    "CUUR0000SETA02": "CPI-U, used cars and trucks, not seasonally adjusted",
                    "CUSR0000SETA02": "CPI-U, used cars and trucks, seasonally adjusted",
                    "CUUR0000SETB01": "CPI-U, gasoline (all types), not seasonally adjusted",
                    "CUSR0000SETB01": "CPI-U, gasoline (all types), seasonally adjusted",
                    "CUUR0000SASLE": "CPI-U, services less energy services, not seasonally adjusted",
                    "CUSR0000SASLE": "CPI-U, services less energy services, seasonally adjusted",
                    "CUUR0000SACL1E": "CPI-U, commodities less food and energy commodities, not seasonally adjusted",
                    "CUSR0000SACL1E": "CPI-U, commodities less food and energy commodities, seasonally adjusted",
                    "LNS14000000": "Unemployment rate, seasonally adjusted",
                    "CES0000000001": "All employees, total nonfarm, seasonally adjusted (thousands)",
                    "CES0500000003": "Average hourly earnings of all employees, total private, seasonally adjusted",
                    "WPUFD4": "PPI, final demand, not seasonally adjusted",
                    "WPSFD4": "PPI, final demand, seasonally adjusted",
                    "WPUFD49104": "PPI, final demand less foods, energy, and trade services, not seasonally adjusted"
                }
            }
        }
    }
}