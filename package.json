{
  "name": "o2h-edge",
  "version": "0.0.1",
  "description": "A Cloudflare Worker that renders JSON APIs as HTML with o2h, at the edge",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "check": "tsc --noEmit -p .",
    "test": "node --test \"test/*.test.*\"",
    "update": "ncu -u && npm install",
    "build-store": "node demo/store/app.mjs",
    "watch-store": "node --watch demo/store/app.mjs",
    "build-bls": "node demo/bls/app.mjs",
    "watch-bls": "node --watch demo/bls/app.mjs",
    "serve": "node ./node_modules/spa-ssi/serve.js"
  },
  "license": "MIT",
  "devDependencies": {
    "spa-ssi": "^0.0.31",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "assign-gingerly": "file:../assign-gingerly",
    "navigate-gingerly": "file:../navigate-gingerly",
    "o2h": "file:../o2h"
  }
}
